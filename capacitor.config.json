{
  "appId": "com.apartman.yonetim",
  "appName": "Apartman Yonetim",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#10b981"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#10b981"
    }
  },
  "ios": {
    "contentInset": "always"
  }
}
